# Para probar la app en local con Docker. Copiar a .env (ignorado por git) y completar:
#   cp .env.example .env
#   make run-local
#   curl -H "X-API-Key: <API_KEY>" http://localhost:8080/tramites/TRM-2026-000123
#   (si el 8080 está ocupado: make run-local PORT=8081)

# Valor de prueba que exige /tramites/{numero} en la cabecera X-API-Key. En Cloud Run llega
# desde Secret Manager. Vacío = la API responde 503 (falla cerrado).
API_KEY=
