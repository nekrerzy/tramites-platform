# Copiar a .env (ignorado por git) y completar. Sin valores reales en este archivo.

# --- Proyecto GCP (lo usa el Makefile) ---
PROJECT_ID=mi-proyecto-gcp
REGION=us-central1
# Formato XXXXXX-XXXXXX-XXXXXX (gcloud billing accounts list)
BILLING_ACCOUNT_ID=
# Moneda de la cuenta de facturación (USD, MXN, ...) y monto del presupuesto en esa moneda.
BUDGET_CURRENCY=USD
BUDGET_AMOUNT=10
# Repositorio de GitHub dueño/nombre: solo sus workflows pueden autenticarse por WIF.
GITHUB_REPO=mi-usuario/tramites-platform

# --- App en local (make run-local) ---
# Valor de prueba; en Cloud Run llega desde Secret Manager.
API_KEY=
APP_VERSION=dev
